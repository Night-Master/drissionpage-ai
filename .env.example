# 复制为 .env 后填写。OpenAI 兼容端点配置，切换平台时修改以下三项：
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# 常见平台参考：
#   qwen: OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1 OPENAI_MODEL=qwen3.8-max
#   kimi: OPENAI_BASE_URL=https://api.kimi.com/coding/v1 OPENAI_MODEL=k3
#   seed: OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3 OPENAI_MODEL=doubao-seed-2.1-turbo
# 模型温度，默认 0；注意 kimi k3 只接受 1
DP_AI_TEMPERATURE=0
# demo 登录用的手机号（bilibili/deepseek demo 使用，自行填写）
DEMO_PHONE=
